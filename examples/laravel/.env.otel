# --- OpenTelemetry (append to your Laravel .env) ---
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=laravel-api
OTEL_RESOURCE_ATTRIBUTES=service.version=1.0.0,deployment.environment=local

# Alloy OTLP HTTP endpoint (use http://alloy:4318 inside docker networks)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Propagate W3C trace context to downstream services
OTEL_PROPAGATORS=baggage,tracecontext
